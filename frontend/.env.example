# Where the FastAPI service lives. Leave unset in dev — Vite proxies /api to
# 127.0.0.1:8000 (see vite.config.js). Set it when the API is on another host.
# VITE_API_BASE=https://api.example.com

# Only if the backend sets API_KEY. It is readable in the built JS, so pair it
# with Vercel Deployment Protection on the frontend.
# VITE_API_KEY=
