# One key for everything — OpenRouter routes both the text and the images.
OPENROUTER_API_KEY=

# LLM — an OpenRouter model slug. Swap vendors freely; see openrouter.ai/models.
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7

# Attribution on the OpenRouter dashboard, and the self-host/proxy override.
OPENROUTER_APP_TITLE=linkedin-post-automation
# OPENROUTER_APP_URL=
# OPENROUTER_API_BASE=

# Source gathering
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TOPIC=news          # general, news or finance
SEARCH_TIME_RANGE=month    # day, week, month or year — how far back sources may go

# Image generation, on the same OpenRouter key. The models that serve images
# are listed at https://openrouter.ai/api/v1/images/models.
IMAGE_MODEL=google/gemini-2.5-flash-image
IMAGE_OUTPUT_FORMAT=png
# Asked of the vendor as a ratio, not exact pixels — vendors serve fixed sizes.
# The exact frame below is cover-cropped afterwards by app/branding.py.
IMAGE_ASPECT_RATIO=16:9
IMAGE_WIDTH=1200
IMAGE_HEIGHT=627
IMAGE_TIMEOUT_SECONDS=120

# How each brand's logo is placed on the shared image. The logo files are per
# brand (see the brand blocks below).
LOGO_POSITION=bottom-right
LOGO_WIDTH_RATIO=0.11
LOGO_MARGIN_RATIO=0.03
LOGO_SHADOW=true      # soft shadow shaped from the mark; no panel behind it
LOGO_KEY_WHITE=true   # key out a JPEG logo's white background

# LinkedIn (OAuth handled separately by the org). One token for every brand's
# page, unless a brand sets its own <BRAND>__LINKEDIN_ACCESS_TOKEN.
LINKEDIN_ACCESS_TOKEN=

# Meta Graph API (Facebook Pages + Instagram).
META_GRAPH_VERSION=v23.0

# Cloudinary, cloudinary://<api_key>:<api_secret>@<cloud_name>. Required for
# images: /image stores each brand's draft here and the frontend shows it by
# URL. Scheduled images wait here and Instagram fetches from here. Empty means
# no images (text-only posts) and no Instagram.
CLOUDINARY_URL=
# Unpublished drafts older than this are deleted by the daily cron.
DRAFT_TTL_HOURS=24

# Scheduled publishing (see SCHEDULER.md). Neon's POOLED url (the -pooler
# host). Empty switches scheduling off; publish-now still works.
DATABASE_URL=
# Vercel Cron sends this as "Authorization: Bearer <secret>" to /cron/dispatch.
CRON_SECRET=
# Optional. When set, every route except /cron needs the X-API-Key header.
API_KEY=

# ---- Brands. One block per brand; anything unset greys out that checkbox. ----
# LINKEDIN_AUTHOR_URN: urn:li:organization:<id> for a company page, or
#   urn:li:person:<sub from /v2/userinfo> for a member. Check with
#   `python scripts/check_linkedin.py <brand>`.
# META_PAGE_TOKEN: a Page access token; it covers both the Facebook Page and
#   the Instagram professional account linked to that Page.
# LOGO_PATH / LOGO_PATH_ON_DARK: override the defaults in app/brands.py.

NBT__LINKEDIN_AUTHOR_URN=
NBT__FACEBOOK_PAGE_ID=
NBT__INSTAGRAM_USER_ID=
NBT__META_PAGE_TOKEN=
# NBT__LOGO_PATH=assets/nbt_logo.jfif
# NBT__LOGO_PATH_ON_DARK=assets/nbt_logo-on-dark.png

PAYPRONEXT__LINKEDIN_AUTHOR_URN=
PAYPRONEXT__FACEBOOK_PAGE_ID=
PAYPRONEXT__INSTAGRAM_USER_ID=
PAYPRONEXT__META_PAGE_TOKEN=
# PAYPRONEXT__LOGO_PATH=assets/paypronext_logo.png

TAXPRONEXT__LINKEDIN_AUTHOR_URN=
TAXPRONEXT__FACEBOOK_PAGE_ID=
TAXPRONEXT__INSTAGRAM_USER_ID=
TAXPRONEXT__META_PAGE_TOKEN=
# TAXPRONEXT__LOGO_PATH=assets/taxpronext_logo.png

# Browser origins allowed to call the API (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Terminal logging: INFO for the readable flow, DEBUG to also see search
# results and the full post text.
LOG_LEVEL=INFO